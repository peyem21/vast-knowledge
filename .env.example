# --- Background push (server-side alerts) ---------------------------------
# Generate a keypair with:  npm run generate:vapid
# Then paste the output here (and into your host's env vars for production).

# Public VAPID key (server side).
VAPID_PUBLIC_KEY=
# Same public key, exposed to the browser so it can create a subscription.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private VAPID key — SECRET, never commit or expose to the client.
VAPID_PRIVATE_KEY=
# Contact identifier sent with pushes (mailto: or https URL).
VAPID_SUBJECT=mailto:you@example.com

# Shared secret protecting the cron evaluation endpoint.
# Vercel Cron automatically sends `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=

# --- Smart-money / whale tracking -----------------------------------------
# Birdeye API key (https://birdeye.so). Enables top holders, supply
# concentration, and whale trades on the token detail page. Optional — the
# feature shows a setup hint until this is set.
BIRDEYE_API_KEY=
